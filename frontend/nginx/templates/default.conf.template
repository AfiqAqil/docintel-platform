# Rendered by the nginx-unprivileged image's own entrypoint, which runs
# envsubst over every file in /etc/nginx/templates/ at container start.
# No custom entrypoint script needed.
#
# DNS_RESOLVER: the VPC DNS address (169.254.169.253) on AWS, or Docker's
# embedded DNS (127.0.0.11) under docker compose. It differs per environment,
# so it is a variable, never a literal.
#
# API_UPSTREAM: the backend host and port, e.g. api.docintel.internal:8000.

server {
    listen 8080;
    server_name _;

    # ECS tasks get replaced on every deploy, so the A record backing
    # API_UPSTREAM changes. nginx resolves a plain hostname once at startup
    # and caches it for the life of the worker process, which would pin
    # requests to a task that no longer exists. The record TTL is 10s
    # (see ARCHITECTURE section 8), so match it here.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # A variable in proxy_pass is what forces re-resolution on the resolver's
    # cycle instead of once at startup. Without the variable, the resolver
    # directive above has no effect on this upstream. This is the line that
    # keeps the frontend from talking to dead API tasks after a deploy.
    set $upstream "${API_UPSTREAM}";

    # Covers the window where a request lands on a task that is draining
    # during a rolling deploy: retry against the next address from the
    # refreshed DNS record rather than failing the request.
    proxy_next_upstream error timeout http_500 http_502 http_503 http_504;

    # JSON API bodies only. The uploaded file itself goes straight from the
    # browser to S3 via a presigned POST and never passes through nginx.
    client_max_body_size 10m;

    # ALB target group health check. Must not depend on the backend: if the
    # API is down the frontend is still correctly serving the SPA, so this
    # stays a 200 from nginx itself with no proxying.
    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /usr/share/nginx/html;
    index index.html;

    # Hashed build assets are content-addressed, so they can be cached
    # forever. index.html names the current hashes, so it must never be
    # cached or a deploy leaves users on a stale shell pointing at assets
    # that no longer exist.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # SPA history fallback so a refresh on a client-side route doesn't 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
